# ==============================================================================
# Floyd Technology Hub — Real-Time Multiplayer Tic-Tac-Toe
# Production & Local Environment Configuration
# ==============================================================================

# --- Backend Configuration (server/.env) ---
NODE_ENV=development
PORT=5000

# Allowed client origins for CORS and Socket.IO
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Production MongoDB Atlas URI (leave empty in local development for in-memory MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/floyd_tictactoe?retryWrites=true&w=majority

# Cryptographically random secrets for guest session JWTs and room codes
SESSION_SECRET=floyd_session_jwt_secret_change_in_production_32chars
ROOM_CODE_SECRET=floyd_room_code_secret_change_in_production_32chars

# Game Engine Lifecycles
ROOM_INACTIVITY_TIMEOUT_MS=1800000
RECONNECTION_GRACE_PERIOD_MS=45000
MAX_CHAT_MESSAGE_LENGTH=300

# --- Frontend Configuration (client/.env) ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

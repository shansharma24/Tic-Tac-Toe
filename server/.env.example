# Floyd Technology Hub - Backend Configuration
NODE_ENV=development
PORT=5000

# Client Origins for CORS and Socket.IO (comma-separated if multiple)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Connection String (leave empty in development to auto-start in-memory MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/floyd_tictactoe?retryWrites=true&w=majority

# JWT / Session Secrets (Use a 32+ char random string in production)
SESSION_SECRET=floyd_secret_session_development_key_change_in_production_123456
ROOM_CODE_SECRET=floyd_room_secret_development_key_654321

# Game Engine Settings
ROOM_INACTIVITY_TIMEOUT_MS=1800000
RECONNECTION_GRACE_PERIOD_MS=45000
MAX_CHAT_MESSAGE_LENGTH=300
